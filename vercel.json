{
  "buildCommand": "node scripts/build.js",
  "outputDirectory": "public",
  "framework": null,
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=600" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/data", "destination": "/api/data" }
  ]
}
